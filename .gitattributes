# Normalize line endings and treat common text files as LF in the repository.
# This helps avoid CRLF/LF churn between Windows and Unix contributors.
# Use `git add --renormalize .` after adding this file to normalize existing files.

# Default: detect text files and normalize to LF in the repo
* text=auto eol=lf

# Explicit rules for common web / source files (ensure LF in repo and on checkout)
*.html    text eol=lf
*.htm     text eol=lf
*.css     text eol=lf
*.js      text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.xml     text eol=lf
*.sh      text eol=lf
*.py      text eol=lf
*.ts      text eol=lf
*.tsx     text eol=lf
*.jsx     text eol=lf

# Keep Windows scripts with CRLF (useful if executed on Windows)
*.ps1     text eol=crlf
*.bat     text eol=crlf
*.cmd     text eol=crlf

# Binary files (do not perform any end-of-line conversion)
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.webp    binary
*.svg     binary
*.pdf     binary
*.zip     binary
*.tar     binary
*.gz      binary
*.7z      binary
*.woff    binary
*.woff2   binary
*.ttf     binary
*.otf     binary

# Ensure Git won't try to alter these (explicitly safe)
*.exe     binary
*.dll     binary

# End of file
